{
  "name": "aria-orchestrator",
  "version": "0.1.0",
  "description": "Artifact-based design workflow orchestrator for Codex",
  "type": "module",
  "bin": {
    "aria": "./dist/src/bin.js"
  },
  "aria": {
    "releaseSource": "github:Phy0waiPaing/ARIA#release"
  },
  "files": [
    "dist/src/",
    "docs/workflows/design-v1.md",
    "schemas/design-proposal-v1.md",
    "design-system/",
    "policies/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
